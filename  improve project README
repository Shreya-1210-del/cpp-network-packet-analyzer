[31m-    T pop() {[m
[31m-        std::unique_lock<std::mutex> lock(mutex_);[m
[31m-        not_empty_.wait(lock, [&]{ return !queue_.empty(); });[m
[31m-        T item = queue_.front();[m
[31m-        queue_.pop();[m
[31m-        return item;[m
[31m-    }[m
[31m-};[m
[31m-```[m
